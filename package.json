{
  "name": "variations",
  "version": "1.3.0",
  "description": "A React component library that enables rapid prototyping and exploration of UI variations. Built for Next.js App Router and AI coding agents.",
  "license": "MIT",
  "author": "Dan Perrera",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:pack": "npm run build && npm pack",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "variations",
    "ui",
    "components",
    "design",
    "prototype",
    "nextjs",
    "app-router",
    "a-b",
    "agent"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dperrera/variations.git"
  },
  "bugs": {
    "url": "https://github.com/dperrera/variations/issues"
  },
  "homepage": "https://github.com/dperrera/variations#readme"
}
